{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<host>.*)\\.vercel\\.app"
        }
      ],
      "destination": "https://www.plauvia.com/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/homepage",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/en/home",
      "destination": "/en/homepage",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/bg",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/bg/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/app/d/:id",
      "destination": "/document/:id",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/document/:id",
      "destination": "/dashboard"
    },
    {
      "source": "/subjects/:id",
      "destination": "/dashboard"
    },
    {
      "source": "/settings/:section",
      "destination": "/dashboard"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(sw.js|cloud.json|manifest.webmanifest|sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
